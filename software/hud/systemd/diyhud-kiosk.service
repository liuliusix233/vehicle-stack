[Unit]
Description=DIYHUD kiosk (cog DRM)
After=diyhud-server.service
[Service]
Environment=XDG_RUNTIME_DIR=/run/diyhud
ExecStartPre=/bin/mkdir -p /run/diyhud
ExecStartPre=/bin/chmod 700 /run/diyhud
ExecStart=/bin/bash /home/<USER>/diyhud/pi/kiosk-run.sh
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
